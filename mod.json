{
	"geode": "4.2.0",
	"gd": {
		"win": "2.2074",
		"android": "2.2074",
		"mac": "2.2074",
		"ios": "2.2074"
	},
	"id": "razoom.object_groups",
	"name": "Object Groups",
	"description": "A mod for grouping objects in the editor tabs",
	"version": "v2.0.0",
	"developer": "RaZooM",
	"tags": ["editor", "enhancement", "utility", "customization", "interface"],
	"links": {
		"source": "https://github.com/RazoomGD/geode-object-groups",
		"community": "https://discord.gg/wcWvtKHP8n"
	},
	"dependencies": [
		{
			"id": "geode.node-ids",
			"version": ">=1.17.0",
			"importance": "required"
		},
		{
			"id": "alphalaneous.editortab_api",
			"version": ">=1.0.10",
			"importance": "required"
		}
	],
	"resources": {
        "sprites": [
            "resources/*.png"
        ]
    },
	"settings": {
		"group-button-color": {
			"type": "string",
			"name": "Button color",
			"description": "The color that all group buttons will have.\n<cy>Note:</c> red, violet, blue, purple and pink buttons have the best contrast",
			"default": "8: blue",
			"one-of": ["1: green", "2: cyan", "3: pink", "4: gray", "5: dark gray", "6: red", "7: violet", "8: blue", "9: purple", "10: pink"]
		},
		"extra-tabs-count": {
			"type": "int",
			"name": "Extra tabs",
			"description": "Number of additional tabs for objects and groups",
			"default": 2,
			"min": 0,
			"max": 5,
			"control": {
				"arrows": true,
				"arrow-step": 1
			}
		}
	}
}
